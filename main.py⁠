class FinanCoreAI:
    def __init__(self, cliente):
        self.cliente = cliente
        self.version = "1.0.0"

    def reporte_ejecutivo(self, ingresos, gastos, inversion):
        beneficio = ingresos - gastos
        margen = (beneficio / ingresos) * 100 if ingresos > 0 else 0
        riesgo = "ALTO" if gastos > (ingresos * 0.8) else "CONTROLADO"
        
        reporte = f"""
        --- REPORTE EJECUTIVO: {self.cliente} ---
        [Estado]: Análisis completado.
        [Beneficio Neto]: ${beneficio:,.2f}
        [Margen de Rentabilidad]: {margen:.2f}%
        [Nivel de Riesgo]: {riesgo}
        [Acción Recomendada]: {'Revisar gastos urgentes' if riesgo == 'ALTO' else 'Continuar expansión'}
        ------------------------------------------
        """
        return reporte

# --- Simulación de uso profesional ---
finan_ia = FinanCoreAI("Usuario Premium")
print(finan_ia.reporte_ejecutivo(10000, 7500, 2000))

